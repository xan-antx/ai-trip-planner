# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_trip_planner

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Model choice is a free-tier quota decision, not a capability one.
# The floating alias gemini-flash-latest currently resolves to gemini-3.6-flash,
# whose free tier allows only 20 requests per project per day. A tool-firing
# chat costs two calls (one to decide on the tool, one to write the answer
# from its result), so that alias is exhausted after roughly 10 hotel
# questions. gemini-flash-lite-latest has far more headroom and is ample for
# this app. Raise it if you move off the free tier.
GEMINI_MODEL=gemini-flash-lite-latest

# LiteAPI (Nuitee) — live hotel data for the MCP server.
# Amadeus Self-Service was decommissioned 17 July 2026 and is no longer usable.
# Get a sandbox key at https://nuitee.com -> Developers -> API Keys (no card required).
LITEAPI_KEY=sand_your-liteapi-sandbox-key
